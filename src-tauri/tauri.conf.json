{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GFC",
  "version": "0.2.5",
  "identifier": "tech.galacticfederation.gfc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GFC",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Galactic Federation",
    "shortDescription": "GFC: Galactic Federation Coin",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRjhEMUI4QThFM0E0RkYKUldUL3BPT291Tkg0ekZjTjlHc3gyMHovT1pZUEZBU3RqU1pJVlRSZXlVVVhaV3JKamlqbFU3Z2oK",
      "endpoints": [
        "https://node.galacticfederation.tech/app/windows/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

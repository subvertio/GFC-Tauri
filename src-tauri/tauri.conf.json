{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GFC",
  "version": "0.2.2",
  "identifier": "tech.galacticfederation.gfc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GFC",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Galactic Federation",
    "shortDescription": "GFC: Galactic Federation Coin",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5OTRDMzJFQkIzRDE5RUEKUldUcUdUMjdMc09VMldyb2FnRU5aa1k4Nm5QeEVFQXQ2bVlFeUtxTVFwWXZoeC9xM1FSY0xPTEgK",
      "endpoints": [
        "https://node.galacticfederation.tech/app/windows/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
